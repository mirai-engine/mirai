package build

import "core:fmt"
import "core:os"
import "core:strings"
import "mirai:project"
import "mirai:std/base"

// The manifest of a plugin is the one declaration of the kinds of asset it
// adds (project.Asset_Kind): a build generates into the package of each kind
// the constants its code names, <STEM>_KIND (the four letters its files begin
// with) and <STEM>_EXTENSION, where .stem is its extension. The file is kept
// by git, so the plugin compiles and tests without a build, and a build writes
// it only when the manifest says something else.

KINDS_FILE :: "kinds_gen.odin"

// The text of the file of the kinds of a package, of the package name given.
kinds_text :: proc(kinds:[]^project.Asset_Kind,package_name:string,allocator:=context.allocator) -> string {
    b:=strings.builder_make(allocator)
    fmt.sbprintf(&b,"package %s\n\n// Generated by mirai build from the asset_kinds of %s: edit that, not this.\n\nimport \"mirai:asset\"\n",package_name,project.PLUGIN_FILE)
    for kind in kinds {
        extension:=base.text_get(kind.extension[:])
        stem:=strings.to_upper(extension[1:],context.temp_allocator)
        fmt.sbprintf(&b,"\n%s_KIND :: asset.Fourcc(u32('%c')|u32('%c')<<8|u32('%c')<<16|u32('%c')<<24)\n",stem,kind.kind[0],kind.kind[1],kind.kind[2],kind.kind[3])
        fmt.sbprintf(&b,"%s_EXTENSION :: %q\n",stem,extension)
    }
    return strings.to_string(b)
}

// The files of the kinds of a plugin, each with its text: one per folder its
// kinds name that has an Odin package; with none, no code names them.
kinds_files :: proc(plugin:^project.Plugin,allocator:=context.allocator) -> [][2]string {
    out:=make([dynamic][2]string,allocator)
    folders:=make([dynamic]string,context.temp_allocator)
    for &kind in plugin.manifest.asset_kinds {
        if base.text_len(kind.extension[:])==0 {continue}
        folder:=base.text_get(kind.folder[:])
        if folder=="" {folder="runtime"}
        known:=false
        for each in folders {known||=each==folder}
        if !known {append(&folders,folder)}
    }
    for folder in folders {
        kinds:=make([dynamic]^project.Asset_Kind,context.temp_allocator)
        for &kind in plugin.manifest.asset_kinds {
            if base.text_len(kind.extension[:])==0 {continue}
            if own:=base.text_get(kind.folder[:]);own==folder || own=="" && folder=="runtime" {append(&kinds,&kind)}
        }
        at:=project.path(plugin.folder,folder,allocator=allocator)
        if name,found:=package_of(at);found {append(&out,[2]string{project.path(at,KINDS_FILE,allocator=allocator),kinds_text(kinds[:],name,allocator)})}
    }
    return out[:]
}

// Writes the files of the kinds of the active plugins that changed.
kinds_write :: proc(p:^project.Project) -> (errors:[]string) {
    out:=make([dynamic]string,context.temp_allocator)
    for index in p.active {
        for file in kinds_files(&p.plugins[index],context.temp_allocator) {
            if current,error:=os.read_entire_file(file[0],context.temp_allocator);error==nil && string(current)==file[1] {continue}
            if os.write_entire_file(file[0],file[1])!=nil {append(&out,fmt.tprintf("%s could not be written",file[0]))}
        }
    }
    return out[:]
}

// The name of the package of the Odin sources of a folder.
@(private="file")
package_of :: proc(folder:string) -> (name:string,found:bool) {
    entries,error:=os.read_all_directory_by_path(folder,context.temp_allocator)
    if error!=nil {return}
    for entry in entries {
        if !strings.has_suffix(entry.name,".odin") || strings.has_suffix(entry.name,"_test.odin") {continue}
        bytes,read:=os.read_entire_file(entry.fullpath,context.temp_allocator)
        if read!=nil {continue}
        text:=string(bytes)
        for line in strings.split_lines_iterator(&text) {
            if strings.has_prefix(line,"package ") {return strings.trim_space(line[len("package "):]),true}
        }
    }
    return
}
