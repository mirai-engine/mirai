package shaders

import "core:encoding/json"
import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"
import "mirai:std/base"

// The probe volume reads the probe hook before the lighting the other hooks
// use: its source has no other hook, and it comes out in an include of its own.
@(test)
the_probe_hook_has_a_source_and_an_include_of_its_own :: proc(t:^testing.T) {
    root:=base.test_folder(t,"shaders")
    if root=="" {return}
    folder:=path_join(root,"gates/shaders",allocator=context.temp_allocator)
    sources:=[]Source{{name="gates",folder=folder}}
    output:=path_join(root,"out",allocator=context.temp_allocator)
    read :: proc(output,name:string) -> string {
        data,_:=os.read_entire_file(path_join(output,"include",name,allocator=context.temp_allocator),context.temp_allocator)
        return string(data)
    }

    fixture_write(t,folder,"gates_probes.slang","//! mirai hook probes gate_probes\nfloat gate_probes(float3 p, float3 d, out float3 b, out float3 f, out float4 m[3]) { return 0.0; }\n")
    files:Sources
    sources_init(&files,context.temp_allocator)
    extensions,error:=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&files,context.temp_allocator)
    testing.expect_value(t,error,"")
    testing.expect_value(t,extensions.probes,"gate_probes")
    testing.expect_value(t,len(extensions.hooks),0)
    testing.expect(t,strings.contains(read(output,EXTENSIONS_INCLUDE),"#define MIRAI_HOOK_PROBES 1"))
    probes:=read(output,PROBES_INCLUDE)
    testing.expect(t,strings.contains(probes,`#include "programs/plugins/gates/gates_probes.slang"`),probes)
    testing.expect(t,strings.contains(probes,"return gate_probes(position,direction,beyond,front,through);"),probes)
    testing.expect(t,!strings.contains(read(output,HOOKS_INCLUDE),"gates_probes"))

    fixture_write(t,folder,"gates_probes.slang","//! mirai hook probes gate_probes\n//! mirai hook ray gate_ray\n")
    again:Sources
    sources_init(&again,context.temp_allocator)
    _,error=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&again,context.temp_allocator)
    testing.expect(t,strings.contains(error,"the probe hook goes in a source of its own"),error)
}

// What a stage is compiled against: only the macros its sources name, and
// without any, the extensions.slang of a generation that has no extensions.
@(test)
extensions_slang_of_a_stage_has_only_the_features_it_names :: proc(t:^testing.T) {
    named:=extension_macros("#ifdef MIRAI_HOOK_RAY\n#if defined(MIRAI_NESTED_VIEWS_OF) || XMIRAI_HOOK_LIGHTS\n    MIRAI_FRAME_EXTENSIONS\n")
    testing.expect_value(t,named,Extension_Features{.Hook_Ray})
    testing.expect_value(t,extension_macros("MIRAI_HOOK_PROBES"),Extension_Features{.Hook_Probes})
    extensions:=Extensions{nested=true,ray="gate",fields=[]Frame_Field{{name="portals",type="Portals_Frame",include="programs/plugins/portals/frame.slang"}}}
    every:=extensions_features(extensions)
    testing.expect_value(t,every,Extension_Features{.Nested_Views,.Hook_Ray,.Frame_Extensions})
    full:=string(extensions_text(extensions,every,context.temp_allocator))
    testing.expect_value(t,full,"// Generated by mirai shaders. DO NOT EDIT.\n#ifndef MIRAI_EXTENSIONS_SLANG\n#define MIRAI_EXTENSIONS_SLANG\n#define MIRAI_NESTED_VIEWS 1\n#define MIRAI_HOOK_RAY 1\n#define MIRAI_FRAME_NESTED 1\n#include \"programs/plugins/portals/frame.slang\"\n#define MIRAI_FRAME_EXTENSIONS Portals_Frame portals;\n#endif\n")
    ray:=string(extensions_text(extensions,{.Hook_Ray},context.temp_allocator))
    testing.expect(t,strings.contains(ray,"#define MIRAI_HOOK_RAY 1\n") && !strings.contains(ray,"NESTED") && !strings.contains(ray,"#include"),ray)
    // The frame fields come after the nested views, which a stage that reads
    // them declares without their code.
    fields:=string(extensions_text(extensions,{.Frame_Extensions},context.temp_allocator))
    testing.expect(t,strings.contains(fields,"#define MIRAI_FRAME_NESTED 1\n") && !strings.contains(fields,"MIRAI_NESTED_VIEWS") && strings.contains(fields,"Portals_Frame portals;"),fields)
    testing.expect_value(t,string(extensions_text(extensions,{},context.temp_allocator)),string(extensions_text(Extensions{},extensions_features(Extensions{}),context.temp_allocator)))
}

// A source that needs the instance ids defines them for the stages that name
// them, and the catalog says so; another need is refused with the ones there are.
@(test)
a_source_asks_for_the_instance_ids :: proc(t:^testing.T) {
    root:=base.test_folder(t,"shaders")
    if root=="" {return}
    folder:=path_join(root,"blend/shaders",allocator=context.temp_allocator)
    sources:=[]Source{{name="blend",folder=folder}}
    output:=path_join(root,"out",allocator=context.temp_allocator)
    fixture_write(t,folder,"blend.comp.slang","//! mirai needs instance_ids\n")
    files:Sources
    sources_init(&files,context.temp_allocator)
    extensions,error:=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&files,context.temp_allocator)
    testing.expect_value(t,error,"")
    testing.expect(t,extensions.instance_ids && !extensions.nested)
    testing.expect_value(t,extension_macros("#ifdef MIRAI_INSTANCE_IDS"),Extension_Features{.Instance_Ids})
    text:=string(extensions_text(extensions,extensions_features(extensions),context.temp_allocator))
    testing.expect(t,strings.contains(text,"#define MIRAI_INSTANCE_IDS 1\n"),text)
    fixture_write(t,folder,"blend.comp.slang","//! mirai needs object_ids\n")
    again:Sources
    sources_init(&again,context.temp_allocator)
    _,error=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&again,context.temp_allocator)
    testing.expect(t,strings.contains(error,"instance_ids"),error)
}

// The vertex hook of batches is one of a generation, in a source of its own,
// and comes out in its include, which the G-buffer reads.
@(test)
the_vertex_hook_has_a_source_and_an_include_of_its_own :: proc(t:^testing.T) {
    root:=base.test_folder(t,"shaders")
    if root=="" {return}
    folder:=path_join(root,"wind/shaders",allocator=context.temp_allocator)
    sources:=[]Source{{name="wind",folder=folder}}
    output:=path_join(root,"out",allocator=context.temp_allocator)
    read :: proc(output,name:string) -> string {
        data,_:=os.read_entire_file(path_join(output,"include",name,allocator=context.temp_allocator),context.temp_allocator)
        return string(data)
    }
    fixture_write(t,folder,"wind_vertex.slang","//! mirai hook vertex wind_bend\nfloat3 wind_bend(float3 w, float3 p, float4 c, float4 q, float t) { return w; }\n")
    files:Sources
    sources_init(&files,context.temp_allocator)
    extensions,error:=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&files,context.temp_allocator)
    testing.expect_value(t,error,"")
    testing.expect_value(t,extensions.vertex,"wind_bend")
    testing.expect_value(t,extension_macros("#ifdef MIRAI_HOOK_VERTEX"),Extension_Features{.Hook_Vertex})
    testing.expect(t,strings.contains(read(output,EXTENSIONS_INCLUDE),"#define MIRAI_HOOK_VERTEX 1"))
    vertex:=read(output,VERTEX_INCLUDE)
    testing.expect(t,strings.contains(vertex,`#include "programs/plugins/wind/wind_vertex.slang"`),vertex)
    testing.expect(t,strings.contains(vertex,"return wind_bend(world,pivot,color,params,time);"),vertex)

    fixture_write(t,folder,"wind_vertex.slang","//! mirai hook vertex wind_bend\n//! mirai hook ray gate_ray\n")
    again:Sources
    sources_init(&again,context.temp_allocator)
    _,error=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&again,context.temp_allocator)
    testing.expect(t,strings.contains(error,"the vertex hook goes in a source of its own"),error)
    fixture_write(t,folder,"wind_vertex.slang","//! mirai hook vertex wind_bend\n")
    fixture_write(t,folder,"other_vertex.slang","//! mirai hook vertex other_bend\n")
    twice:Sources
    sources_init(&twice,context.temp_allocator)
    _,error=extensions_generate(nil,ENGINE_ROOT,"",output,"",sources,&twice,context.temp_allocator)
    testing.expect(t,strings.contains(error,"already has a vertex hook"),error)
}

// The nested views go right after the part of Frame_Data that the renderer mirrors, wherever the
// reflection puts its end, and each field of the extensions takes up to the next one.
@(test)
the_frame_reflection_places_the_nested_views_after_what_the_renderer_mirrors :: proc(t:^testing.T) {
    reflection :: proc(t:^testing.T,nested:int) -> json.Object {
        text:=fmt.tprintf(`{{"parameters":[{{"name":"mirai_frame","type":{{"kind":"constantBuffer","elementType":{{"kind":"struct","name":"Frame_Data","fields":[`+
            `{{"name":"frame_index","binding":{{"kind":"uniform","offset":0,"size":4}}}},`+
            `{{"name":"moved_lights","binding":{{"kind":"uniform","offset":16,"size":64}}}},`+
            `{{"name":"nested","binding":{{"kind":"uniform","offset":%d,"size":32}}}},`+
            `{{"name":"portals","binding":{{"kind":"uniform","offset":%d,"size":16}}}}],"sizes":[{{"kind":"uniform","value":%d}}]}}}}}}]}}`,nested,nested+32,nested+48)
        value,error:=json.parse_string(text,parse_integers=true,allocator=context.temp_allocator)
        testing.expect_value(t,error,json.Error.None)
        return value.(json.Object)
    }
    extensions:=Extensions{nested=true,fields=[]Frame_Field{{name="portals",type="Portals_Frame"}}}
    testing.expect_value(t,extensions_frame_read(&extensions,reflection(t,80)),"")
    testing.expect(t,extensions.frame_size==128 && extensions.fields[0].offset==112 && extensions.fields[0].size==16)
    problem:=extensions_frame_read(&extensions,reflection(t,96))
    testing.expect(t,strings.contains(problem,"nested views"),problem)
}

// A plugin declares a constant it shares with its shaders once, in Odin: the
// generation writes it into the include of the plugin, and says what a line
// that cannot be followed lacks.
@(test)
a_plugin_shares_the_constants_of_its_odin_code :: proc(t:^testing.T) {
    root:=base.test_folder(t,"shaders")
    if root=="" {return}
    folder:=path_join(root,"gates/shaders",allocator=context.temp_allocator)
    sources:=[]Source{{name="gates",folder=folder}}
    include:=path_join(root,"out/include",allocator=context.temp_allocator)
    fixture_write(t,path_join(root,"gates/runtime",allocator=context.temp_allocator),"gates.odin","package gates\n\nGATE_CAPACITY :: 8 // of a scene\nGATE_WORDS :u32: 0x10\nGATE_REACH :: 2.5\nGATE_CAPACITY_SQUARED :: GATE_CAPACITY*GATE_CAPACITY\ngate_count := 3\n")
    fixture_write(t,folder,"gates.slang","//! mirai constant GATE_CAPACITY int ../runtime/gates.odin\n//! mirai constant GATE_WORDS uint ../runtime/gates.odin\n//! mirai constant GATE_REACH float ../runtime/gates.odin\n")
    files:Sources
    sources_init(&files,context.temp_allocator)
    shared,problem:=owned_constants_write(&files,include,"",sources,context.temp_allocator)
    testing.expect_value(t,problem,"")
    written,_:=os.read_entire_file(path_join(include,"constants/plugins/gates.slang",allocator=context.temp_allocator),context.temp_allocator)
    testing.expect_value(t,string(written),shared)
    testing.expect(t,strings.contains(shared,"#define GATE_CAPACITY 8\n#define GATE_WORDS 16u\n#define GATE_REACH 2.5\n"),shared)
    // The stamp of a generation follows the Odin source.
    testing.expect(t,path_join(root,"gates/runtime/gates.odin",allocator=context.temp_allocator) in files.files)

    for each in ([]struct{line,says:string}{
        {"//! mirai constant GATE_CAPACITY int","<file.odin>"},
        {"//! mirai constant GATE_CAPACITY word ../runtime/gates.odin","<int|uint|float>"},
        {"//! mirai constant GATE_CAPACITY int ../runtime/missing.odin","could not read"},
        {"//! mirai constant GATE_HEIGHT int ../runtime/gates.odin","does not declare"},
        {"//! mirai constant gate_count int ../runtime/gates.odin","does not declare"},
        {"//! mirai constant GATE_CAPACITY_SQUARED int ../runtime/gates.odin","declared with its number"},
        {"//! mirai constant GATE_REACH uint ../runtime/gates.odin","declared with its number"},
        {"//! mirai constant GATE_CAPACITY int ../runtime/gates.odin\n//! mirai constant GATE_CAPACITY uint ../runtime/gates.odin","already share"},
    }) {
        fixture_write(t,folder,"gates.slang",each.line)
        again:Sources
        sources_init(&again,context.temp_allocator)
        _,problem=owned_constants_write(&again,include,"",sources,context.temp_allocator)
        testing.expectf(t,strings.contains(problem,each.says),"%s: %s",each.line,problem)
    }
    // Without a line, no include: a source that named it would not compile.
    fixture_write(t,folder,"gates.slang","// nothing shared\n")
    none:Sources
    sources_init(&none,context.temp_allocator)
    shared,problem=owned_constants_write(&none,include,"",sources,context.temp_allocator)
    testing.expect(t,shared=="" && problem=="" && !os.exists(path_join(include,"constants",allocator=context.temp_allocator)))
}
