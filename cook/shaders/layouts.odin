package shaders

import "core:encoding/json"
import "core:fmt"
import "core:strings"

// The structs shaders share with the CPU and the types of mirai:render that
// mirror them, field for field and with the same names. Slang lays them out
// once per generation in a probe (layouts_probe); every stage that uses one
// has to lay it out the same way, and the engine's Odin table asserts the
// size and the offset of each field of the mirror with offset_of.
@(private)
Shared_Struct :: struct {
    slang,odin:string,
    last:string,  // the last field the mirror has: those after it belong to the generation (nested views, extensions); "": all
    guard:string, // a define the struct exists under; "": always
}
// The last field of Frame_Data that render.Gpu_Frame mirrors: what a generation adds goes after it.
FRAME_MIRROR_LAST :: "sun_map_rows"
@(private)
SHARED_STRUCTS :: []Shared_Struct{
    {slang="Frame_Data",odin="Gpu_Frame",last=FRAME_MIRROR_LAST},
    {slang="Nested_View",odin="Gpu_Nested",guard="MIRAI_FRAME_NESTED"},
    {slang="Vertex",odin="Gpu_Vertex"},
    {slang="Thumbnail_Vertex",odin="Gpu_Thumbnail_Vertex"},
    {slang="Cluster",odin="Gpu_Cluster"},
    {slang="Posed_Vertex",odin="Gpu_Posed_Vertex"},
    {slang="Instance",odin="Gpu_Instance"},
    {slang="Mesh_Ray",odin="Gpu_Mesh_Ray"},
    {slang="Mesh",odin="Gpu_Mesh"},
    {slang="Material",odin="Gpu_Material"},
    {slang="Material_Map_Transform",odin="Gpu_Material_Map_Transform"},
    {slang="Material_Coat",odin="Gpu_Material_Coat"},
    {slang="Material_Fuzz",odin="Gpu_Material_Fuzz"},
    {slang="Material_Anisotropy",odin="Gpu_Material_Anisotropy"},
    {slang="Material_Diffuse_Transmission",odin="Gpu_Material_Diffuse_Transmission"},
    {slang="Material_Row",odin="Gpu_Material_Row"},
    {slang="Light",odin="Gpu_Light"},
    {slang="Light_Node",odin="Gpu_Light_Node"},
    {slang="Bvh_Node",odin="Gpu_Bvh_Node"},
    {slang="Bvh_Triangle",odin="Gpu_Bvh_Triangle"},
    {slang="Probe",odin="Gpu_Probe"},
    {slang="Ui_Vertex",odin="Ui_Vertex"},
    {slang="Ui_Shape",odin="Ui_Shape"},
    {slang="Post_Parameters",odin="Gpu_Post_Parameters"},
}

@(private)
Shared_Field :: struct {name:string,offset,size:int}
@(private)
Shared_Layout :: struct {name:string,size:int,fields:[]Shared_Field}

// The source of the probe: a buffer of each shared struct.
@(private)
layouts_probe_source :: proc(allocator:=context.allocator) -> string {
    b:=strings.builder_make(allocator)
    strings.write_string(&b,"// Generated by mirai shaders: the structs shaders share with the CPU, for their layouts.\n#include \"native.slang\"\n#include \"common.slang\"\n#include \"ui_shape.slang\"\n")
    for shared,i in SHARED_STRUCTS {
        if shared.guard!="" {fmt.sbprintf(&b,"#ifdef %s\n",shared.guard)}
        fmt.sbprintf(&b,"[[vk::binding(%d, 0)]] StructuredBuffer<%s> layout_%d;\n",i,shared.slang,i)
        if shared.guard!="" {strings.write_string(&b,"#endif\n")}
    }
    strings.write_string(&b,"[shader(\"compute\")] [numthreads(1, 1, 1)] void main() {}\n")
    return strings.to_string(b)
}

// The layouts of the shared structs a reflection of Slang holds, found by
// name wherever they appear.
@(private)
layouts_reflected :: proc(data:json.Object,allocator:=context.allocator) -> []Shared_Layout {
    found:=make([dynamic]Shared_Layout,allocator)
    visit :: proc(value:json.Value,found:^[dynamic]Shared_Layout,allocator:=context.allocator) {
        #partial switch v in value {
        case json.Object:
            if json_text(v["kind"])=="struct" {
                name:=json_text(v["name"])
                known,seen:=false,false
                for shared in SHARED_STRUCTS {known||=shared.slang==name}
                for layout in found {seen||=layout.name==name}
                if known && !seen {
                    layout:=Shared_Layout{name=strings.clone(name,allocator),size=-1}
                    sizes,_:=v["sizes"].(json.Array)
                    for entry in sizes {
                        object,_:=entry.(json.Object)
                        if layout.size<0 && json_text(object["kind"])=="uniform" {layout.size,_=json_int(object["value"])}
                    }
                    fields,_:=v["fields"].(json.Array)
                    out:=make([]Shared_Field,len(fields),allocator)
                    for entry,i in fields {
                        field,_:=entry.(json.Object)
                        binding,_:=field["binding"].(json.Object)
                        out[i].name=strings.clone(json_text(field["name"]),allocator)
                        out[i].offset,_=json_int(binding["offset"])
                        out[i].size,_=json_int(binding["size"])
                    }
                    layout.fields=out
                    append(found,layout)
                }
            }
            for _,child in v {visit(child,found,allocator)}
        case json.Array:
            for child in v {visit(child,found,allocator)}
        }
    }
    visit(data["parameters"],&found,allocator)
    return found[:]
}

// What differs between the layouts of a stage and those of the probe: "" when
// every shared struct the stage uses is laid out as the probe lays it out. A
// struct whose end belongs to the generation may stop after the part the CPU
// mirrors: a stage declares only what it reads of it (MIRAI_FRAME_NESTED).
@(private)
layouts_compare :: proc(stage,probe:[]Shared_Layout,allocator:=context.allocator) -> string {
    for layout in stage {
        expected:Shared_Layout
        last:=""
        for other in probe {if other.name==layout.name {expected=other}}
        for shared in SHARED_STRUCTS {if shared.slang==layout.name {last=shared.last}}
        whole:=expected.size==layout.size && len(expected.fields)==len(layout.fields)
        prefix:=false
        if last!="" && len(layout.fields)<len(expected.fields) {for field in layout.fields {prefix||=field.name==last}}
        same:=expected.name!="" && (whole || prefix)
        if same {for field,i in layout.fields {same&&=field.name==expected.fields[i].name && field.offset==expected.fields[i].offset}}
        if !same {return fmt.aprintf("%s: shader layout disagrees with the one shared with the CPU (%d bytes)",layout.name,layout.size,allocator=allocator)}
    }
    return ""
}

// The assertions of the Odin table: the size of each mirror and the offset of
// each of its fields as the probe laid them out. An error for a struct the
// probe should have and does not, after the assertions of the others.
@(private)
layouts_assertions :: proc(b:^strings.Builder,probe:[]Shared_Layout) -> (error:string) {
    strings.write_string(b,"\n// The structs shaders share with the CPU, as Slang lays them out.\n")
    for shared in SHARED_STRUCTS {
        layout:Shared_Layout
        for other in probe {if other.name==shared.slang {layout=other}}
        if layout.name=="" {
            if shared.guard=="" && error=="" {error=fmt.tprintf("the probe of the shared structs has no %s",shared.slang)}
            continue
        }
        size:=layout.size
        for field in layout.fields {
            fmt.sbprintf(b,"#assert(offset_of(%s, %s) == %d)\n",shared.odin,field.name,field.offset)
            if field.name==shared.last {
                size=field.offset+field.size
                break
            }
        }
        fmt.sbprintf(b,"#assert(size_of(%s) == %d)\n",shared.odin,size)
    }
    return
}
