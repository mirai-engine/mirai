package shaders

import "core:fmt"
import "core:reflect"
import "core:strings"
import "mirai:asset"
import "mirai:render/abi"
import "mirai:rhi"

// The include with what shaders know of the material schema of mirai:asset:
// the kinds of maps, the alpha modes and the default values. The engine's
// common.slang includes it, so asset/material.odin is the only place they are
// written.
SCHEMA_INCLUDE :: "material_schema.slang"

// The text of SCHEMA_INCLUDE; it is also part of every fingerprint.
@(private)
material_schema :: proc(allocator:=context.temp_allocator) -> string {
    b:=strings.builder_make(allocator)
    strings.write_string(&b,"// Generated by mirai shaders from mirai:asset. DO NOT EDIT.\n#ifndef MIRAI_MATERIAL_SCHEMA_SLANG\n#define MIRAI_MATERIAL_SCHEMA_SLANG\n")
    strings.write_string(&b,"// asset.Material_Map_Kind: the index of the texture and of the transform of each map.\n")
    for name,i in reflect.enum_field_names(asset.Material_Map_Kind) {fmt.sbprintf(&b,"#define MATERIAL_MAP_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    fmt.sbprintf(&b,"#define MATERIAL_MAPS %d\n",len(asset.Material_Map_Kind))
    strings.write_string(&b,"// asset.Alpha_Mode\n")
    for name,i in reflect.enum_field_names(asset.Alpha_Mode) {fmt.sbprintf(&b,"#define ALPHA_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    strings.write_string(&b,"// asset.Emission_Mode\n")
    for name,i in reflect.enum_field_names(asset.Emission_Mode) {fmt.sbprintf(&b,"#define EMISSION_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    strings.write_string(&b,"// asset.Material_Layers: the bit of each layer a material holds besides the base.\n")
    for name,i in reflect.enum_field_names(asset.Material_Layer) {fmt.sbprintf(&b,"#define MATERIAL_LAYER_%s %du\n",strings.to_upper(name,context.temp_allocator),u32(1)<<uint(i))}
    d:=asset.MATERIAL_DEFAULTS
    strings.write_string(&b,"// asset.MATERIAL_DEFAULTS\n")
    color :: proc(b:^strings.Builder,name:string,value:[3]f32) {fmt.sbprintf(b,"#define MATERIAL_DEFAULT_%s float3(%s, %s, %s)\n",name,number(value.x),number(value.y),number(value.z))}
    scalar :: proc(b:^strings.Builder,name:string,value:f32) {fmt.sbprintf(b,"#define MATERIAL_DEFAULT_%s %s\n",name,number(value))}
    color(&b,"BASE_COLOR",d.base_color)
    scalar(&b,"OPACITY",d.opacity)
    scalar(&b,"METALLIC",d.metallic)
    scalar(&b,"ROUGHNESS",d.roughness)
    color(&b,"EMISSION",d.emission)
    color(&b,"SPECULAR_COLOR",d.specular_color)
    scalar(&b,"SPECULAR_FACTOR",d.specular_factor)
    scalar(&b,"IOR",d.ior)
    color(&b,"COAT_COLOR",d.coat.color)
    scalar(&b,"COAT_ROUGHNESS",d.coat.roughness)
    scalar(&b,"COAT_IOR",d.coat.ior)
    color(&b,"FUZZ_COLOR",d.fuzz.color)
    scalar(&b,"FUZZ_ROUGHNESS",d.fuzz.roughness)
    color(&b,"DIFFUSE_TRANSMISSION_COLOR",d.diffuse_transmission.color)
    strings.write_string(&b,"#endif\n")
    return strings.to_string(b)
}

// The include with the constants shaders share with the CPU, each written from
// the Odin constant that declares it (mirai:render/abi, mirai:asset,
// mirai:rhi): no shader writes one of them.
CONSTANTS_INCLUDE :: "shared_constants.slang"

// The text of CONSTANTS_INCLUDE; it is also part of every fingerprint.
@(private)
shared_constants :: proc(allocator:=context.temp_allocator) -> string {
    b:=strings.builder_make(allocator)
    strings.write_string(&b,"// Generated by mirai shaders from mirai:render/abi, mirai:asset and mirai:rhi. DO NOT EDIT.\n#ifndef MIRAI_SHARED_CONSTANTS_SLANG\n#define MIRAI_SHARED_CONSTANTS_SLANG\n")
    i :: proc(b:^strings.Builder,name:string,value:int) {fmt.sbprintf(b,"#define %s %d\n",name,value)}
    u :: proc(b:^strings.Builder,name:string,value:u32) {fmt.sbprintf(b,"#define %s %du\n",name,value)}
    f :: proc(b:^strings.Builder,name:string,value:f32) {fmt.sbprintf(b,"#define %s %s\n",name,number(value))}
    size :: proc(b:^strings.Builder,name:string,value:[2]u32) {fmt.sbprintf(b,"#define %s float2(%s, %s)\n",name,number(f32(value.x)),number(f32(value.y)))}

    i(&b,"SLOT_FRAME",abi.SLOT_FRAME)
    i(&b,"SLOT_PARAMS",abi.SLOT_PARAMS)
    i(&b,"SLOT_LINEAR_SAMPLER",abi.SLOT_LINEAR_SAMPLER)
    i(&b,"SLOT_POINT_SAMPLER",abi.SLOT_POINT_SAMPLER)
    i(&b,"SLOT_INSTANCES",abi.SLOT_INSTANCES)
    i(&b,"SLOT_MESHES",abi.SLOT_MESHES)
    i(&b,"SLOT_VERTICES",abi.SLOT_VERTICES)
    i(&b,"SLOT_INDICES",abi.SLOT_INDICES)
    i(&b,"SLOT_MATERIALS",abi.SLOT_MATERIALS)
    i(&b,"SLOT_LIGHTS",abi.SLOT_LIGHTS)
    i(&b,"SLOT_LIGHT_TREE",abi.SLOT_LIGHT_TREE)
    i(&b,"SLOT_BLAS_NODES",abi.SLOT_BLAS_NODES)
    i(&b,"SLOT_BLAS_TRIANGLES",abi.SLOT_BLAS_TRIANGLES)
    i(&b,"SLOT_TLAS_NODES",abi.SLOT_TLAS_NODES)
    i(&b,"SLOT_TLAS_REFS",abi.SLOT_TLAS_REFS)
    i(&b,"SLOT_MATERIAL_SAMPLER",abi.SLOT_MATERIAL_SAMPLER)
    i(&b,"SLOT_PROBES",abi.SLOT_PROBES)
    i(&b,"SLOT_IRRADIANCE",abi.SLOT_IRRADIANCE)
    i(&b,"SLOT_POINTS",abi.SLOT_POINTS)
    i(&b,"SLOT_PASS0",abi.SLOT_PASS0)
    i(&b,"SLOT_PASS1",abi.SLOT_PASS1)
    i(&b,"SLOT_PASS2",abi.SLOT_PASS2)
    i(&b,"SLOT_PASS3",abi.SLOT_PASS3)
    i(&b,"SLOT_PASS4",abi.SLOT_PASS4)
    i(&b,"SLOT_PASS5",abi.SLOT_PASS5)
    i(&b,"SLOT_PASS6",abi.SLOT_PASS6)
    i(&b,"SLOT_PASS7",abi.SLOT_PASS7)
    i(&b,"SLOT_PASS8",abi.SLOT_PASS8)
    i(&b,"SLOT_PASS9",abi.SLOT_PASS9)
    i(&b,"SLOT_TLAS",abi.SLOT_TLAS)
    i(&b,"SLOT_SURFACE",abi.SLOT_SURFACE)
    i(&b,"SLOT_VIEWS",abi.SLOT_VIEWS)
    i(&b,"SLOT_LAYERS",abi.SLOT_LAYERS)
    i(&b,"SLOT_DISTANCE",abi.SLOT_DISTANCE)
    i(&b,"SLOT_DRAW",abi.SLOT_DRAW)
    i(&b,"MATERIAL_TEXTURE_SLOT",rhi.TEXTURE_TABLE_SLOT)
    u(&b,"TEXTURE_TABLE_RESERVED",abi.TEXTURE_RESERVED)
    u(&b,"DFG_TEXTURE",abi.DFG_TEXTURE)
    u(&b,"AIR_TRANSMITTANCE_TEXTURE",abi.AIR_TRANSMITTANCE_TEXTURE)
    u(&b,"AIR_SCATTERING_TEXTURE",abi.AIR_SCATTERING_TEXTURE)
    u(&b,"AIR_SKY_TEXTURE",abi.AIR_SKY_TEXTURE)
    u(&b,"TEXTURE_FEEDBACK_FIRST",abi.TEXTURE_FEEDBACK_FIRST)
    i(&b,"TEXTURE_FEEDBACK_SLOT",abi.TEXTURE_FEEDBACK_SLOT)
    f(&b,"TEXTURE_FEEDBACK_LOW",abi.TEXTURE_FEEDBACK_LOW)
    f(&b,"TEXTURE_FEEDBACK_STEPS",abi.TEXTURE_FEEDBACK_STEPS)
    u(&b,"TEXTURE_FEEDBACK_CODES",abi.TEXTURE_FEEDBACK_CODES)
    f(&b,"MATERIAL_ANISOTROPY",abi.MATERIAL_ANISOTROPY)

    i(&b,"NESTED_VIEW_CAPACITY",abi.NESTED_VIEW_CAPACITY)
    i(&b,"VOLUME_CASCADES_MAX",abi.VOLUME_CASCADES_MAX)
    i(&b,"OCCLUDER_CHANGES_MAX",abi.OCCLUDER_CHANGES_MAX)
    i(&b,"LIGHT_MOVES_MAX",abi.LIGHT_MOVES_MAX)
    u(&b,"OCCLUDERS_MANY",abi.OCCLUDERS_MANY)
    f(&b,"SUN_UNSHADOWED",abi.SUN_UNSHADOWED)
    u(&b,"MOVED_SUN",abi.MOVED_SUN)
    u(&b,"MOVED_LIGHTS_ALL",abi.MOVED_LIGHTS_ALL)
    f(&b,"ORIGIN_STEP",abi.ORIGIN_STEP)
    u(&b,"FRAME_FLAG_GI",abi.FRAME_FLAG_GI)
    u(&b,"FRAME_FLAG_GI_GIVEN",abi.FRAME_FLAG_GI_GIVEN)
    u(&b,"FRAME_FLAG_HW_RT",abi.FRAME_FLAG_HW_RT)
    u(&b,"FRAME_FLAG_STUDIO",abi.FRAME_FLAG_STUDIO)
    u(&b,"FRAME_FLAG_GRID",abi.FRAME_FLAG_GRID)
    u(&b,"FRAME_FLAG_GLASS",abi.FRAME_FLAG_GLASS)
    u(&b,"FRAME_FLAG_REFLECTANCE",abi.FRAME_FLAG_REFLECTANCE)
    u(&b,"FRAME_FLAG_NEUTRAL",abi.FRAME_FLAG_NEUTRAL)

    u(&b,"INSTANCE_MESH_MASK",abi.INSTANCE_MESH_MASK)
    u(&b,"INSTANCE_RAY_SHIFT",abi.INSTANCE_RAY_SHIFT)
    u(&b,"INSTANCE_FLAG_HIDDEN",abi.INSTANCE_FLAG_HIDDEN)
    u(&b,"INSTANCE_FLAG_SMALL",abi.INSTANCE_FLAG_SMALL)
    u(&b,"INSTANCE_FLAG_ALPHA_TESTED",abi.INSTANCE_FLAG_ALPHA_TESTED)
    u(&b,"INSTANCE_FLAG_UNIFORM_COLOR",abi.INSTANCE_FLAG_UNIFORM_COLOR)
    u(&b,"INSTANCE_FLAG_BLENDED",abi.INSTANCE_FLAG_BLENDED)
    u(&b,"INSTANCE_FLAG_TRANSLUCENT",abi.INSTANCE_FLAG_TRANSLUCENT)
    u(&b,"INSTANCE_HIGHLIGHT_SHIFT",abi.INSTANCE_HIGHLIGHT_SHIFT)
    u(&b,"INSTANCE_FLAG_OWNED",abi.INSTANCE_FLAG_OWNED)
    u(&b,"INSTANCE_OWNER_SHIFT",abi.INSTANCE_OWNER_SHIFT)
    u(&b,"INSTANCE_LAYERS_SHIFT",abi.INSTANCE_LAYERS_SHIFT)
    u(&b,"HIGHLIGHT_LEVELS",abi.HIGHLIGHT_LEVELS)
    u(&b,"OUTLINE_STYLES",abi.OUTLINE_STYLES)

    i(&b,"MESH_RAY_LEVELS",asset.MESH_RAY_LEVELS)
    u(&b,"MESH_FLAG_CLOSED",abi.MESH_FLAG_CLOSED)
    u(&b,"MESH_FLAG_LEVEL0",abi.MESH_FLAG_LEVEL0)
    u(&b,"MESH_FLAG_SURFACE",abi.MESH_FLAG_SURFACE)
    u(&b,"MESH_FLAG_UV1",abi.MESH_FLAG_UV1)
    u(&b,"MESH_FLAG_COLORS",abi.MESH_FLAG_COLORS)
    u(&b,"MESH_FLAG_STREAMED",abi.MESH_FLAG_STREAMED)

    u(&b,"CLUSTER_WORDS",abi.CLUSTER_WORDS)
    u(&b,"VERTEX_WORDS",abi.VERTEX_WORDS)
    u(&b,"POSED_WORDS",abi.POSED_WORDS)
    u(&b,"PAGE_ENTRY_WORDS",abi.PAGE_ENTRY_WORDS)
    u(&b,"LEVEL_WORDS",abi.LEVEL_WORDS)
    u(&b,"CLUSTER_TRIANGLES",asset.CLUSTER_TRIANGLES)
    u(&b,"CLUSTER_DRAW_VERTICES",abi.CLUSTER_DRAW_VERTICES)
    u(&b,"CLUSTER_CONE",asset.CLUSTER_CONE)
    u(&b,"PRIMITIVE_TRIANGLE_BITS",abi.PRIMITIVE_TRIANGLE_BITS)
    u(&b,"PAGE_SLOT_WORDS",abi.PAGE_SLOT_WORDS)
    u(&b,"PAGE_REQUEST_FIRST",abi.PAGE_REQUEST_FIRST)
    u(&b,"BATCH_GROUP",abi.BATCH_GROUP)
    u(&b,"BATCH_WORDS",abi.BATCH_WORDS)
    u(&b,"POSED_BOUNDS_WORDS",abi.POSED_BOUNDS_WORDS)
    u(&b,"POSED_BOUNDS_BOX",abi.POSED_BOUNDS_BOX)
    u(&b,"POSED_BOUNDS_CONE",abi.POSED_BOUNDS_CONE)

    u(&b,"RAY_SOLID",abi.RAY_SOLID)
    u(&b,"RAY_GLASS",abi.RAY_GLASS)
    u(&b,"RAY_SMALL",abi.RAY_SMALL)
    u(&b,"RAY_SHADOW_ONLY",abi.RAY_SHADOW_ONLY)
    u(&b,"RAY_UNSHADOWED",abi.RAY_UNSHADOWED)
    u(&b,"TLAS_REF_GLASS",abi.TLAS_REF_GLASS)
    u(&b,"TLAS_ALPHA_TESTED",rhi.TLAS_ALPHA_TESTED)
    u(&b,"TLAS_TABLE_HEADER",rhi.TLAS_TABLE_HEADER)
    u(&b,"TLAS_DISPATCH_X",rhi.TLAS_DISPATCH_X)
    u(&b,"TLAS_LAYOUT_ROWS",rhi.TLAS_LAYOUT_ROWS)

    f(&b,"LIGHT_POINT",abi.GPU_LIGHT_POINT)
    f(&b,"LIGHT_RECT",abi.GPU_LIGHT_RECT)
    u(&b,"LIGHT_NODE_LEAF",abi.GPU_LIGHT_NODE_LEAF)
    u(&b,"LIGHT_NODE_SPOT",abi.GPU_LIGHT_NODE_SPOT)
    u(&b,"LIGHT_NODE_COUNT_SHIFT",abi.GPU_LIGHT_NODE_COUNT_SHIFT)
    i(&b,"LIGHT_TREE_DEPTH",abi.LIGHT_TREE_DEPTH)
    i(&b,"LIGHT_CUT_MAX",abi.LIGHT_CUT_MAX)
    u(&b,"LIGHT_WEIGHT_ROWS",abi.LIGHT_WEIGHT_ROWS)
    u(&b,"SHADOW_MAP_ROWS",abi.SHADOW_MAP_ROWS)
    u(&b,"SHADOW_LIGHT_FACES",abi.SHADOW_LIGHT_FACES)
    u(&b,"SHADOW_LIGHT_HASH",abi.SHADOW_LIGHT_HASH)
    u(&b,"SHADOW_SPOT_FACE",abi.SHADOW_SPOT_FACE)
    u(&b,"SHADOW_MAP_ORTHOGRAPHIC",abi.SHADOW_MAP_ORTHOGRAPHIC)
    i(&b,"SUN_MAP_ROWS",abi.SUN_MAP_ROWS)
    u(&b,"SHADOW_ENTRIES",abi.SHADOW_ENTRIES)
    u(&b,"SHADOW_TESTED_ENTRIES",abi.SHADOW_TESTED_ENTRIES)
    u(&b,"CONTACT_RAYS",abi.CONTACT_RAYS)
    f(&b,"SHARED_RAY_ROUGHNESS",abi.REFLECTION_SHARED_ROUGHNESS)
    i(&b,"DISTANCE_TILE",abi.DISTANCE_TILE)
    u(&b,"PROBE_BUCKETS",abi.PROBE_BUCKETS)

    i(&b,"DFG_SIZE",abi.DFG_SIZE)
    size(&b,"AIR_TRANSMITTANCE_SIZE",abi.AIR_TRANSMITTANCE_SIZE)
    f(&b,"AIR_SCATTERING_SIZE",abi.AIR_SCATTERING_SIZE)
    size(&b,"AIR_SKY_SIZE",abi.AIR_SKY_SIZE)
    u(&b,"AIR_SKY_ROWS",abi.AIR_SKY_ROWS)
    u(&b,"AIR_AERIAL_SIZE",abi.AIR_AERIAL_SIZE)
    u(&b,"AIR_AERIAL_SLICES",abi.AIR_AERIAL_SLICES)
    i(&b,"DISPLAY_LUT_SIZE",abi.DISPLAY_LUT_SIZE)
    f(&b,"MIDDLE_GRAY",abi.MIDDLE_GRAY)
    u(&b,"EXPOSURE_BINS",abi.EXPOSURE_BINS)
    i(&b,"DEPTH_PROBE_CAPACITY",abi.DEPTH_PROBE_CAPACITY)
    i(&b,"DEPTH_PROBE_CELLS",abi.DEPTH_PROBE_CELLS)
    f(&b,"DEPTH_PROBE_CELL",abi.DEPTH_PROBE_CELL)
    i(&b,"WIND_VOLUMES",abi.WIND_VOLUMES)
    i(&b,"VOLUME_OUTLINE_POINTS",abi.VOLUME_OUTLINE_POINTS)

    u(&b,"POINTS_CAPACITY",abi.POINTS_CAPACITY)
    u(&b,"POINTS_PROGRAMS",abi.POINTS_PROGRAMS)
    u(&b,"POINTS_WANTED",abi.POINTS_WANTED)
    u(&b,"POINTS_COUNT",abi.POINTS_COUNT)
    u(&b,"POINTS_BASE",abi.POINTS_BASE)
    u(&b,"POINTS_LIMIT",abi.POINTS_LIMIT)
    u(&b,"POINTS_HEADS",abi.POINTS_HEADS)
    u(&b,"POINTS_HEADS_BASE",abi.POINTS_HEADS_BASE)
    u(&b,"POINTS_HEADS_LIMIT",abi.POINTS_HEADS_LIMIT)
    u(&b,"POINTS_FROM",abi.POINTS_FROM)
    u(&b,"POINTS_TO",abi.POINTS_TO)
    u(&b,"POINTS_HEADS_FROM",abi.POINTS_HEADS_FROM)
    u(&b,"POINTS_HEADS_TO",abi.POINTS_HEADS_TO)
    u(&b,"POINTS_ARGS",abi.POINTS_ARGS)
    u(&b,"POINTS_HEAD_ARGS",abi.POINTS_HEAD_ARGS)
    u(&b,"POINTS_HEADER",abi.POINTS_HEADER)
    u(&b,"POINT_WORDS",abi.POINT_WORDS)
    u(&b,"RECORD_WORDS",abi.RECORD_WORDS)
    u(&b,"HEAD_WORDS",abi.HEAD_WORDS)
    u(&b,"PROGRAMS_COUNT",abi.PROGRAMS_COUNT)
    u(&b,"PROGRAMS_DISPATCH",abi.PROGRAMS_DISPATCH)
    u(&b,"PROGRAMS_HEADER",abi.PROGRAMS_HEADER)
    u(&b,"PROGRAM_PARAMETER_BYTES",abi.PROGRAM_PARAMETER_BYTES)
    u(&b,"INSTANCE_VALUES_MAX",abi.INSTANCE_VALUES_MAX)
    u(&b,"INSTANCE_VALUE_WORDS",abi.INSTANCE_VALUE_WORDS)
    u(&b,"INSTANCE_VALUE_COUNT_SHIFT",abi.INSTANCE_VALUE_COUNT_SHIFT)
    u(&b,"INSTANCE_VALUE_STANDARD",abi.INSTANCE_VALUE_STANDARD)
    for name,i in reflect.enum_field_names(abi.Instance_Value) {u(&b,strings.concatenate({"INSTANCE_VALUE_",strings.to_upper(name,context.temp_allocator)},context.temp_allocator),abi.INSTANCE_VALUE_STANDARD+u32(i))}
    for name,value in reflect.enum_field_names(abi.Debug_View) {u(&b,strings.concatenate({"DEBUG_",strings.to_upper(name,context.temp_allocator)},context.temp_allocator),u32(value))}
    strings.write_string(&b,"#endif\n")
    return strings.to_string(b)
}

// Writes both includes into the include folder of a generation or of a check.
@(private)
schema_write :: proc(include:string) -> bool {
    return write_file(path_join(include,SCHEMA_INCLUDE,allocator=context.temp_allocator),transmute([]u8)material_schema(context.temp_allocator)) &&
        write_file(path_join(include,CONSTANTS_INCLUDE,allocator=context.temp_allocator),transmute([]u8)shared_constants(context.temp_allocator))
}

// The shortest float literal of Slang that reads back as the same f32.
@(private)
number :: proc(value:f32) -> string {
    b:=strings.builder_make(context.temp_allocator)
    float_text(&b,f64(value),32)
    return strings.to_string(b)
}
