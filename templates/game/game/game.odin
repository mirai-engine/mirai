package game

import "mirai:core"
import abilities "plugins:abilities/runtime"
import destruct "plugins:destruct/runtime"
import inp "mirai:engine/input"
import locomotion "plugins:locomotion/runtime"
import phys "plugins:physics/runtime"
import save "mirai:engine/save"
import scene "mirai:engine/scene"
import "mirai:std/base"

// A small game built only with the public API of the engine, to copy from.
// The player is a physics character driven by the input actions move, look,
// jump, hit (breaks the wall in front of it), use (held at the wall, shatters
// it: an Interactable), save and load (the slot "quick"), bound in code. assets/arena/main.scene holds a floor, a
// spawn point, a destructible wall, a speaker that plays a sound, a HUD
// (UI_Screen) with a pulsing badge and a sign above the speaker
// (World_Widget); both interfaces show the Status component of their entity.
// settings.mirai names the prefab of the player (Spawn_Settings.prefab): the
// spawn library gives each player a body of it at that point, the player of
// this machine and, on a server, each connection. Its camera is at its eyes (Camera_Follow Eyes). It runs
// alone, as a server (--server) or as a client (--connect): the server breaks
// the wall; every client predicts its own player. The scene and the prefab of
// the player are files of assets/, edited through the API or the editor;
// tools/content writes the assets generated by code. game/shell.odin is its
// main menu, pause and settings. The player sprints with an energy bar and
// jumps off ledges with a boost: abilities of assets/player/movement.records
// (sprint, ledge_jump) with the attributes below, and game_ledge_jump.

HIT_REACH :: f32(3)                     // how far from the eye a hit lands
HIT_RADIUS :: f32(0.6)
HIT_IMPULSE :: f32(40)                  // N s, along the view
SHATTER_RADIUS :: f32(3)                // around the wall a held use shatters
SAVE_SLOT :: "quick"

// On the character of a player.
@(component)
Player :: struct {}

// The attributes of the Ability_User of the player (Player.scene): the energy its sprint spends,
// and those whose values scale its walk (Ability_User.speed, jump and acceleration), which the
// windows of the sprint raise.
ATTRIBUTE_ENERGY :: abilities.Ability_Attribute(1)
ATTRIBUTE_SPEED :: abilities.Ability_Attribute(2)
ATTRIBUTE_JUMP :: abilities.Ability_Attribute(3)
ATTRIBUTE_ACCELERATION :: abilities.Ability_Attribute(4)

// A jump off a ledge: standing, with the ground falling away by drop m within reach m ahead along
// where it goes, jump uses ability (ledge_jump), whose sheet asks for the speed of a run and adds
// its boost to the jump. The world ahead is the game's to judge (game_ledge_jump).
@(component)
Ledge_Jump :: struct {
    ability:core.Record(abilities.Ability),
    reach:f32 `mirai:"min=0,unit=m"`,
    drop:f32 `mirai:"min=0,unit=m"`,
}
LEDGE_JUMP_DEFAULT :: Ledge_Jump{reach=1.5,drop=1.9}

// What the HUD and the sign show: their interfaces bind to these fields by name.
@(component,shared)
Status :: struct {
    message:[48]u8 `mirai:"text"`,
    hits:i32,
}

// The actions of the game; move and look are of the engine (inp.Move_Action, inp.Look_Action) and
// jump of the locomotion plugin (Walk_Action).
@(actions)
Action :: enum u8 {Hit,Use,Save,Load}

// Their bindings. The editor (Project Settings > Input), settings.set and the
// player keep in Input_Settings of settings.mirai only what they change of these.
action_defaults :: proc "contextless" () -> [Action]inp.Action_Bindings {
    return {
        .Hit=inp.action_default(.Button,inp.binding_mouse_button(.Left),inp.binding_gamepad_axis(.Right_Trigger)),
        .Use=inp.action_default(.Button,inp.binding_key(.E),inp.binding_gamepad_button(.West)),
        .Save=inp.action_default(.Button,inp.binding_key(.F5),inp.binding_gamepad_button(.Dpad_Up)),
        .Load=inp.action_default(.Button,inp.binding_key(.F9),inp.binding_gamepad_button(.Back)),
    }
}

@(private="file")
status_show :: proc(statuses:^core.Table(Status),message:string,hit:=false) {
    for &status in core.writable(statuses) {
        base.text_set(status.message[:],message)
        if hit {status.hits+=1}
    }
}

// A hit damages what the view meets within reach, where it meets it: the
// wall or a piece of it. The server decides it, and a session alone.
@(step="fixed",server)
game_hit :: proc(
    players:^core.Table(Player,.Read),aims:inp.Aims,
    actions:inp.Input_Of(Action),physics:core.Ref(phys.Physics_State),damage:^destruct.Destruct_Requests,
) {
    for row in 0..<core.count(players) {
        e:=core.entity_at(players,row)
        eye,ahead,_,aimed:=inp.aim(aims,e)
        if !aimed || !inp.pressed(actions,e,.Hit) {continue}
        if hit,found:=phys.raycast(physics,eye,ahead,HIT_REACH,e);found {destruct.damage(damage,hit.entity,hit.point,HIT_RADIUS,ahead*HIT_IMPULSE)}
    }
}

// The wall is an Interactable and the player an Interactor of the action
// use: a use held at the wall to its end shatters what is left of it. The
// server decides it, as a hit.
@(step="fixed",server)
game_shatter :: proc(used:core.Ref(scene.Interaction_Events),aims:inp.Aims,damage:^destruct.Destruct_Requests) {
    for event in used.items {
        if event.kind!=.Completed {continue}
        wall,placed:=core.get(aims.worlds,event.target)
        if !placed {continue}
        _,ahead,_,_:=inp.aim(aims,event.actor)
        destruct.damage(damage,event.target,wall.position,SHATTER_RADIUS,ahead*HIT_IMPULSE*4)
    }
}

// A jump at a ledge asks for the ledge jump, which starts with the jump where its sheet allows
// it. Every end runs it for the characters it decides (abilities applies a use only there).
@(step="fixed")
game_ledge_jump :: proc(
    jumpers:^core.Table(Ledge_Jump,.Read),grounds:^core.Table(phys.Character_State,.Read),motions:^core.Table(core.Motion,.Read),
    walk_actions:inp.Input_Of(locomotion.Walk_Action),physics:core.Ref(phys.Physics_State),requests:^abilities.Ability_Requests,
) {
    for row in 0..<core.count(jumpers) {
        e:=core.entity_at(jumpers,row)
        ledge:=core.at(jumpers,row)
        ground,_:=core.get(grounds,e)
        if !ground.standing || !inp.pressed(walk_actions,e,.Jump) {continue}
        capsule,made:=phys.character_capsule(physics,e)
        motion,_:=core.get(motions,e)
        if made && locomotion.ledge_ahead(physics,capsule,motion.linear-ground.ground_velocity,ledge.reach,ledge.drop) {
            abilities.ability_use(requests,e,ledge.ability)
        }
    }
}

// Every end tells its player what the use does at what it focuses.
@(step="fixed")
game_prompt :: proc(statuses:^core.Table(Status),used:core.Ref(scene.Interaction_Events)) {
    for event in used.items {
        #partial switch event.kind {
        case .Focused:   status_show(statuses,"Hold E to shatter the wall")
        case .Cancelled: status_show(statuses,"Let go too soon")
        case .Completed: status_show(statuses,"Shattered!")
        }
    }
}

// Every end counts the hits the wall took.
@(step="fixed")
game_play :: proc(statuses:^core.Table(Status),broken:core.Ref(destruct.Destruct_Events)) {
    for _ in broken.applied.items {status_show(statuses,"Hit!",true)}
}

// Save and load use the slot of the game; a session on a network does not
// save. A frame step: results arrive by frame, also with the clock paused.
@(step="frame")
game_saves :: proc(
    statuses:^core.Table(Status),network:core.Ref(core.Network),actions:inp.Frame_Input_Of(Action),
    saves:^save.Save_Requests,results:core.Ref(save.Save_Results),
) {
    if network.role!=.Standalone {return}
    if inp.pressed(actions,.Save) {save.request_save(saves,SAVE_SLOT)}
    if inp.pressed(actions,.Load) {save.request_load(saves,SAVE_SLOT)}
    for result in results.items {
        if result.error!=.None {
            status_show(statuses,"The slot could not be used")
            continue
        }
        status_show(statuses,result.op==.Save?"Saved":"Loaded")
    }
}
