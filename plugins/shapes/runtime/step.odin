package shapes

import "mirai:core"
import "mirai:host"
import render "mirai:engine/render"
import volume "mirai:engine/volume"
import physics "plugins:physics/runtime"
import "core:mem"
import "core:slice"
import "mirai:std/base"
import "mirai:std/geom"
import "mirai:std/jobs"
import mm "mirai:std/math"
import "base:runtime"

// What a world derives from its shapes and the splines with a material: the
// mesh each one shows, generated by this world, and what each brush was when
// its solid was last looked at. It
// is not copied with the world: a copy (Play, rollback) finds the children of
// its shapes, makes its own meshes for them and never releases those of
// another world.
@(storage,host,by_world,free="shapes_cache_free")
Shapes_Cache :: struct {
    entries:core.Entity_Map(Shape_Entry), // by shape or spline entity
    brushes:core.Entity_Map(Brush_Entry), // by brush entity
    shapes_seen,splines_seen,bodies_seen,colliders_seen,brushes_seen,places_seen,parents_seen:core.Seen,
    dirty:[dynamic]core.Entity,
    gathered:[dynamic]Brush,     // the brushes of the solid being looked at, in order
    builds:[dynamic]Shape_Build, // slots kept between passes
    pass:u32,
}

// What a brush was the last time it was compared: a change of any of it
// takes its solid, and the one it left, into the pass.
@(private)
Brush_Entry :: struct {
    solid:core.Entity,    // its parent
    previous:core.Entity, // the brush before it under that parent; NONE for the first
    brush:Brush,
}

@(private)
Shape_Entry :: struct {
    child:core.Entity,  // with Shape_Part; NONE before the first build
    mesh:base.Asset_Id, // generated by this world; zero without one
    key:u64,            // shape_key of what mesh was made from
    pass:u32,           // the last pass that took it
    spline:bool,        // of a Spline without a Shape
    place:mm.Transform, // of a spline, in the world: where it lies
    laid:u32,           // of a spline, how many changes of the ground under it it was laid again on
}

@(private)
Shape_Build :: struct {
    entity:core.Entity,
    shape:Shape,
    brushes:[dynamic]Brush,
    body:bool,
    spline:bool,    // its geometry holds the points of a ribbon
    material:base.Asset_Id,
    cut_first:bool, // a brush that cuts comes before the first that adds
    key:u64,
    collider:physics.Collider,
    limits:host.Assets_Limits,
    error:Shape_Error,
    geometry:Shape_Geometry,
    render:host.Mesh_Render_Geometry,
    render_ready:bool,
}

// Frees the memory of the cache when the application ends: its meshes go with the assets.
shapes_cache_free :: proc(cache:^Shapes_Cache) {
    core.entity_map_destroy(&cache.entries)
    core.entity_map_destroy(&cache.brushes)
    delete(cache.dirty)
    delete(cache.gathered)
    for &b in cache.builds {
        delete(b.brushes)
        shape_geometry_destroy(&b.geometry)
        host.assets_render_geometry_destroy(&b.render)
    }
    delete(cache.builds)
    cache^={}
}

// What the cache made for a World that is freed goes with it.
@(step="release")
shapes_release :: proc(cache:^Shapes_Cache,assets:^host.Assets) {
    if cache==nil {return}
    for entry in cache.entries.values {
        if entry.mesh!={} && assets!=nil {host.assets_mesh_release(assets,entry.mesh)}
    }
    core.entity_map_clear(&cache.entries)
    core.entity_map_clear(&cache.brushes)
}

// Keeps the child of every shape showing and colliding, and of every spline
// with a material showing its ribbon, as its source says: only the shapes
// whose Shape, Rigid_Body or Collider changed, or one of whose brushes changed,
// came, went or moved among them, and the splines that changed, moved or whose
// ground changed, are built again, all of them in parallel, and their meshes
// are generated here.
@(step="fixed frame",loops="game editor",stage="simulate",before="physics_prepare")
shapes_update :: proc(
    cache:^Shapes_Cache,assets:^host.Assets,job_system:^jobs.Job_System,allocator:runtime.Allocator,commands:core.Commands,
    shapes:core.Read(Shape),brushes:core.Read(Shape_Brush),parts:core.Read(Shape_Part),rigids:core.Read(physics.Rigid_Body),
    colliders:^core.Table(physics.Collider),meshes:^core.Table(render.Mesh_Renderer),
    transforms:core.Read(core.Transform),parents:core.Read(core.Parent),hierarchy:core.Ref(core.Hierarchy),problems:^core.Problems,
    splines:core.Read(volume.Spline),ground:core.Ref(core.Ground_Queries),world:core.World_Ref,
) {
    if cache==nil || assets==nil {return}
    cs:=core.changes(shapes,&cache.shapes_seen)
    cp:=core.changes(splines,&cache.splines_seen)
    cb:=core.changes(rigids,&cache.bodies_seen)
    cc:=core.changes(colliders,&cache.colliders_seen)
    cr:=core.changes(brushes,&cache.brushes_seen)
    all:=cs.all || cp.all
    // While there are brushes they are compared every tick: what moves one is
    // its Transform, whose stamps belong to every entity of the world.
    following:=core.count(brushes)>0 || len(cache.brushes.values)>0
    // Splines lie where their entity is and on the ground: | runs both, so each keeps what it saw.
    lying:=core.count(splines)>0
    q:=lying?core.ground_query(world,ground):{}
    placed:=lying && (core.touched(transforms,&cache.places_seen) | core.touched(parents,&cache.parents_seen))
    under:=lying && ground.ptr!=nil?ground.changed.items[:]:nil
    grounded:=len(under)>0
    if !all && !following && !placed && !grounded && quiet(cs) && quiet(cp) && quiet(cb) && quiet(cc) {return}
    context.allocator=allocator
    u:=Update{cache=cache,assets=assets,commands=commands,shapes=shapes,brushes=brushes,parts=parts,rigids=rigids,colliders=colliders,meshes=meshes,transforms=transforms,parents=parents,hierarchy=hierarchy,problems=problems,splines=splines}

    // The shapes and splines that went take their child and their mesh with them.
    if all || len(cs.gone)>0 || len(cp.gone)>0 {
        #reverse for entry,i in cache.entries.values {
            if source(&u,cache.entries.entities[i]) {continue}
            entry_end(&u,entry)
            core.entity_map_remove_at(&cache.entries,i)
        }
    }
    if all {
        // A child whose source went while another world looked after it.
        for row in 0..<core.count(parts) {
            child:=core.entity_at(parts,row)
            parent,has:=core.get(parents,child)
            if !has || !source(&u,parent.entity) {core.commands_destroy(commands,child)}
        }
    }

    cache.pass+=1
    clear(&cache.dirty)
    for row in core.each_changed(shapes,&cs) {mark(&u,core.entity_at(shapes,row))}
    for row in core.each_changed(splines,&cp) {mark(&u,core.entity_at(splines,row))}
    if !all {
        for e in cs.gone {mark(&u,e)}
        for row in core.each_changed(rigids,&cb) {mark(&u,core.entity_at(rigids,row))}
        for e in cb.gone {mark(&u,e)}
        for row in core.each_changed(colliders,&cc) {mark(&u,core.entity_at(colliders,row))}
        for e in cc.gone {mark(&u,e)}
    }
    if placed || grounded {
        for &entry,i in cache.entries.values {
            if !entry.spline {continue}
            e:=cache.entries.entities[i]
            place,_:=core.world_of(transforms,parents,e)
            if place!=entry.place {
                mark(&u,e)
            } else if grounded && volume.spline_under(splines,e,place,under) {
                entry.laid+=1
                mark(&u,e)
            }
        }
    }
    if following {brushes_follow(&u,cr)}
    if len(cache.dirty)==0 {return}

    used:=0
    limits:=host.assets_limits(assets)
    for e in cache.dirty {
        entry:=core.entity_map_get(&cache.entries,e)
        if entry==nil {continue}
        row:=core.row_of(shapes,e)
        spline,has_spline:=core.get(splines,e)
        entry.spline=row<0
        key:u64
        material:base.Asset_Id
        body,cut_first:=false,false
        collider:=physics.COLLIDER_DEFAULT
        if row>=0 {
            if has_spline && spline.material!={} {
                core.report(problems,e,"shapes.both","the entity has a Shape and a Spline with a material, and draws only the Shape: move the Spline to an entity of its own")
            }
            shape:=&shapes.table.values[row]
            body=core.has(rigids,e)
            gathered:bool
            cut_first,gathered=brushes_gather(&u,e,shape)
            if !gathered {
                core.report(problems,e,"shapes.memory","no memory to gather the brushes of the shape: it keeps its previous mesh; free memory or remove brushes")
                continue
            }
            key,material,collider=shape_key(shape,cache.gathered[:],body),shape.material,collider_of(&u,e,body)
        } else {
            entry.place,_=core.world_of(transforms,parents,e)
            if !has_spline || spline.material=={} {
                // A path nothing here draws: a river, which the water draws, or a patrol.
                entry_end(&u,entry^)
                entry.child,entry.mesh=core.NONE,{}
                continue
            }
            material=spline.material
            key=base.hash64(mem.ptr_to_bytes(&entry.place),u64(entry.laid))
            key=base.hash64(mem.ptr_to_bytes(&material),key)
            key=base.hash64(slice.to_bytes(spline.points[:min(int(spline.count),volume.SPLINE_POINTS)]),key)
        }
        entry.child=child_find(&u,e,entry.child)
        if entry.mesh!={} && entry.key==key && entry.child!=core.NONE && child_shows(&u,entry.child,entry.mesh) {
            collider_write(&u,entry.child,collider,entry.spline)
            continue
        }
        if used==len(cache.builds) {
            if append(&cache.builds,Shape_Build{})!=1 {
                core.report(problems,e,"shapes.memory","no memory to build the shape: it keeps its previous mesh; free memory or remove shapes")
                continue
            }
            b:=&cache.builds[used]
            b.brushes=make([dynamic]Brush,allocator)
            shape_geometry_init(&b.geometry,allocator)
            host.assets_render_geometry_init(&b.render,allocator)
        }
        b:=&cache.builds[used]
        clear(&b.brushes)
        b.entity,b.body,b.spline,b.material,b.cut_first,b.key,b.collider,b.limits=e,body,entry.spline,material,cut_first,key,collider,limits
        if entry.spline {
            ribbon_lay(q,&spline,entry.place,&b.geometry)
        } else if append(&b.brushes,..cache.gathered[:])!=len(cache.gathered) {
            core.report(problems,e,"shapes.memory","no memory to build the shape: it keeps its previous mesh; free memory or remove brushes")
            continue
        } else {
            b.shape=shapes.table.values[row]
        }
        used+=1
    }
    if used==0 {return}

    builds:=cache.builds[:used]
    if jobs.worker_count(job_system)>0 {
        jobs.parallel_for(job_system,jobs.OWNER,used,1,build_range,&builds)
    } else {
        build_range(&builds,0,used,jobs.OWNER)
    }
    for &b in builds {install(&u,&b)}
}

@(private)
Update :: struct {
    cache:^Shapes_Cache,
    assets:^host.Assets,
    commands:core.Commands,
    shapes:core.Read(Shape),
    brushes:core.Read(Shape_Brush),
    parts:core.Read(Shape_Part),
    rigids:core.Read(physics.Rigid_Body),
    colliders:^core.Table(physics.Collider),
    meshes:^core.Table(render.Mesh_Renderer),
    transforms:core.Read(core.Transform),
    parents:core.Read(core.Parent),
    hierarchy:core.Ref(core.Hierarchy),
    problems:^core.Problems,
    splines:core.Read(volume.Spline),
}

// Nothing was written, added or removed since the reader looked.
@(private)
quiet :: proc "contextless" (c:core.Changes) -> bool {
    return !c.written && len(c.gone)==0
}

// Whether an entity has what the cache draws: a Shape or a Spline.
@(private)
source :: proc(u:^Update,e:core.Entity) -> bool {
    return core.has(u.shapes,e) || core.has(u.splines,e)
}

// Takes a shape or a spline into the pass, once.
@(private)
mark :: proc(u:^Update,e:core.Entity) {
    if !source(u,e) {return}
    entry:=core.entity_map_get(&u.cache.entries,e)
    if entry==nil {
        if held:=core.entity_map_held(&u.cache.entries,e);held!=core.NONE {
            if old:=core.entity_map_get(&u.cache.entries,held);old!=nil {entry_end(u,old^)}
            core.entity_map_remove(&u.cache.entries,held)
        }
        made,ok:=core.entity_map_put(&u.cache.entries,e,Shape_Entry{})
        if !ok {
            core.report(u.problems,e,"shapes.memory","no memory to follow the shape: free memory or remove shapes")
            return
        }
        entry=made
    }
    if entry.pass==u.cache.pass {return}
    entry.pass=u.cache.pass
    append(&u.cache.dirty,e)
}

// Compares every brush with what it was: one that came, went, changed its
// Shape_Brush or local Transform, or moved to another parent or place among
// its siblings takes its solid into the pass, and the solid it left.
@(private)
brushes_follow :: proc(u:^Update,changes:core.Changes) {
    cache:=u.cache
    at,left:=0,Brush_Entry{}
    for _ in core.entity_map_left(&cache.brushes,u.brushes,changes,&at,&left) {
        if left.solid!=core.NONE {mark(u,left.solid)}
    }
    for row in 0..<core.count(u.brushes) {
        e:=core.entity_at(u.brushes,row)
        b,_:=brush_of(u,e)
        now:=Brush_Entry{solid=core.NONE,previous=core.NONE,brush=b}
        if parent,has:=core.get(u.parents,e);has {now.solid,now.previous=parent.entity,brush_before(u,e)}
        entry:=core.entity_map_get(&cache.brushes,e)
        if entry!=nil && entry^==now {continue}
        if entry!=nil && entry.solid!=now.solid && entry.solid!=core.NONE {mark(u,entry.solid)}
        if now.solid!=core.NONE {mark(u,now.solid)}
        if entry!=nil {
            entry^=now
        } else if _,ok:=core.entity_map_put(&cache.brushes,e,now);!ok {
            core.report(u.problems,e,"shapes.memory","no memory to follow the brush: free memory or remove brushes")
        }
    }
}

// The brush of an entity in the frame of its parent.
@(private)
brush_of :: proc(u:^Update,e:core.Entity) -> (b:Brush,ok:bool) {
    value:=core.get(u.brushes,e) or_return
    place:=mm.TRANSFORM_IDENTITY
    if t,has:=core.get(u.transforms,e);has {place=core.to_math(t)}
    return {kind=value.kind,op=value.op,place=place},true
}

// The brush before e among the children of its parent; NONE for the first.
@(private)
brush_before :: proc(u:^Update,e:core.Entity) -> core.Entity {
    h:=u.hierarchy
    if h.ptr==nil {return core.NONE}
    at:=e
    for {
        i:=int(core.entity_index(at))
        if i>=len(h.previous_sibling) {return core.NONE}
        at=h.previous_sibling[i]
        if at==core.NONE || core.has(u.brushes,at) {return at}
    }
}

// The brushes of a Solid, its children with Shape_Brush in their order, into
// cache.gathered; whether one that cuts or intersects comes first, with no
// polygon nor a brush that adds before it.
@(private)
brushes_gather :: proc(u:^Update,e:core.Entity,shape:^Shape) -> (cut_first,ok:bool) {
    clear(&u.cache.gathered)
    if core.count(u.brushes)==0 {return false,true}
    adds:=shape.loop_count>0
    for child:=core.first_child(u.hierarchy,e);child!=core.NONE;child=core.next_sibling(u.hierarchy,child) {
        b:=brush_of(u,child) or_continue
        if append(&u.cache.gathered,b)!=1 {return false,false}
        if b.op!=.Union && !adds {cut_first=true}
        adds||=b.op==.Union
    }
    return cut_first && adds,true
}

// Ends what an entry made: its mesh and its child.
@(private)
entry_end :: proc(u:^Update,entry:Shape_Entry) {
    if entry.mesh!={} {host.assets_mesh_release(u.assets,entry.mesh)}
    if entry.child!=core.NONE {core.commands_destroy(u.commands,entry.child)}
}

// The child of a shape that has Shape_Part: the one it knew if it still
// hangs from it, else the first under it. Any other is destroyed.
@(private)
child_find :: proc(u:^Update,e,known:core.Entity) -> core.Entity {
    found:=core.NONE
    if known!=core.NONE && core.has(u.parts,known) {
        if parent,has:=core.get(u.parents,known);has && parent.entity==e {found=known}
    }
    for child:=core.first_child(u.hierarchy,e);child!=core.NONE;child=core.next_sibling(u.hierarchy,child) {
        if child==found || !core.has(u.parts,child) {continue}
        if found==core.NONE {found=child} else {core.commands_destroy(u.commands,child)}
    }
    return found
}

@(private)
child_shows :: proc(u:^Update,child:core.Entity,mesh:base.Asset_Id) -> bool {
    row:=core.row_of(u.meshes,child)
    return row>=0 && u.meshes.values[row].mesh==mesh
}

// The collider of the child: the surface and filtering of the Collider of the
// shape when it has one, of kind Hull for a body and Mesh without one.
@(private)
collider_of :: proc(u:^Update,e:core.Entity,body:bool) -> physics.Collider {
    c:=physics.COLLIDER_DEFAULT
    if row:=core.row_of(u.colliders,e);row>=0 {
        c=u.colliders.values[row]
        if c.kind!=.External {
            core.report(u.problems,e,"shapes.collider","the Collider of a shape gives the surface and filtering of its derived collider, and physics makes a %v of its own: make it kind External",c.kind)
        }
    }
    c.kind=body?.Hull:.Mesh
    c.size,c.center={},{}
    return c
}

// The child of a spline collides with nothing.
@(private)
collider_write :: proc(u:^Update,child:core.Entity,collider:physics.Collider,spline:bool) {
    row:=core.row_of(u.colliders,child)
    if spline {
        if row>=0 {core.remove(u.colliders,child)}
    } else if row<0 {
        core.commands_add(u.commands,child,collider)
    } else if u.colliders.values[row]!=collider {
        core.edit(u.colliders,child)^=collider
    }
}

@(private)
build_range :: proc(builds:^[]Shape_Build,first,last,worker:int) {
    for &b in builds[first:last] {
        b.render_ready=false
        b.error=b.spline?ribbon_build(&b.geometry):shape_geometry_build(&b.shape,b.brushes[:],b.body,&b.geometry)
        if b.error==.None && b.limits.renderer {
            b.render_ready=host.assets_render_geometry_make(geom.mesh_buffer_view(&b.geometry.mesh),nil,1,&b.render,b.limits)
        }
    }
}

// Generates the mesh of a build and gives it to the child of its shape; a
// shape that could not be built keeps the mesh it had.
@(private)
install :: proc(u:^Update,b:^Shape_Build) {
    entry:=core.entity_map_get(&u.cache.entries,b.entity)
    if entry==nil {return}
    if b.error!=.None {
        codes,messages:=BUILD_CODES,BUILD_MESSAGES
        core.report(u.problems,b.entity,codes[b.error],"%s; it keeps its previous mesh",messages[b.error])
        return
    }
    if b.cut_first {
        core.report(u.problems,b.entity,"shapes.first_brush","a brush of the Solid that cuts or intersects comes before the first one that adds and has nothing to work on, so it is left out: order the children so a brush that adds comes first, or give the Solid a polygon")
    }
    spline:=b.spline
    options:=host.Mesh_Generate_Options{no_lods=true,collision=!spline}
    if spline {
    } else if b.body {
        options.hull_points,options.hull_sizes=b.geometry.pieces.points[:],b.geometry.pieces.sizes[:]
    } else {
        options.collision_mesh,options.disabled_edges=geom.mesh_buffer_view(&b.geometry.collision),b.geometry.disabled_edges[:]
    }
    if b.render_ready {options.render_geometry=&b.render}
    slots:=[1]base.Asset_Id{b.material}
    id,ok:=host.assets_mesh_generate(u.assets,geom.mesh_buffer_view(&b.geometry.mesh),slots[:],nil,options)
    if !ok {
        core.report(u.problems,b.entity,"shapes.mesh","the mesh of the shape was not generated (out of memory or assets full); it keeps its previous mesh: free memory or remove shapes")
        return
    }
    if entry.mesh!={} {host.assets_mesh_release(u.assets,entry.mesh)}
    entry.mesh,entry.key=id,b.key
    shown:=render.Mesh_Renderer{mesh=id}
    if entry.child==core.NONE {
        child:=core.commands_create(u.commands)
        core.commands_add(u.commands,child,core.Parent{entity=b.entity})
        core.commands_add(u.commands,child,core.TRANSFORM_IDENTITY)
        core.commands_add(u.commands,child,Shape_Part{})
        core.commands_add(u.commands,child,shown)
        if !spline {core.commands_add(u.commands,child,b.collider)}
        entry.child=child
        return
    }
    if row:=core.edit(u.meshes,entry.child);row!=nil {row^=shown} else {core.commands_add(u.commands,entry.child,shown)}
    collider_write(u,entry.child,b.collider,spline)
}

@(private)
BUILD_CODES :: [Shape_Error]string{
    .None="",
    .Invalid="shapes.invalid",
    .Empty="shapes.empty",
    .Too_Many_Points="shapes.too_many_points",
    .Too_Many_Loops="shapes.too_many_loops",
    .Self_Intersecting="shapes.self_intersecting",
    .Geometry="shapes.geometry",
    .Out_Of_Memory="shapes.memory",
}

@(private)
BUILD_MESSAGES :: [Shape_Error]string{
    .None="",
    .Invalid="the Shape or the Spline has a value out of range: a polygon needs a positive depth and loops of at least 3 finite points that add up to point_count, brushes a Transform with a finite position and a positive scale, a Spline from 2 to 64 finite points with a width above 0 and a finite height, uv_scale is 0 or positive, and a bevel is 0 or positive with at most 16 Round segments, or Points that go from the cap (1,0) to the side (0,1) without turning back; edit it with the shapes procedures",
    .Empty="the Shape leaves nothing to build: give it a polygon of at least 3 points or a child with a Shape_Brush that adds",
    .Too_Many_Points="the Shape has more points than it holds: simplify the outline",
    .Too_Many_Loops="the Shape has more holes than it holds: merge or remove holes",
    .Self_Intersecting="the outline of the Shape crosses or touches itself, or a hole leaves it or meets another: move the vertices so no edges meet",
    .Geometry="the triangulation of the outline or the boolean of the brushes failed: avoid brushes with coincident faces or too thin to have volume",
    .Out_Of_Memory="no memory to build the Shape: free memory or remove shapes",
}
