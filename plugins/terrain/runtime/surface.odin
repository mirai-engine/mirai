package terrain

import "core:mem"
import render "mirai:engine/render"
import "mirai:host"
import "mirai:std/base"

// What a piece of a Heightfield shows between its vertices, whatever its
// level: maps of its samples, a texel each (a node, every spacing samples),
// which the Terrain_Layers program reads at each point
// (terrain_surface.slang). The weights of the layers, their automatic rules
// applied, with the hole of each cell; the normal of the surface; and the
// color and roughness painted over the layers. Its vertices carry where they
// are over the maps in uv0, in texels. A level changes the triangles and
// leaves the maps: the light and the layers do not jump with it.
//
// A piece of a Volume has no maps: each vertex carries in uv0 and uv1 the
// weights of the four layers of the piece that weigh most there (palette).

Surface_Maps :: struct {
    size:[2]int,           // texels across and down; zero for a Volume
    spacing:int,           // samples between texels
    control:[dynamic]u32,  // the Weights of each texel, the hole of the cell from it in WEIGHT_HOLE
    normal:[dynamic][4]u8, // of the surface in the space of the terrain, 0 to 255 over -1 to 1
    paint:[dynamic][4]u8,  // empty when the source has nothing painted
    holed:bool,            // a triangle spans cells that are holes and cells that are not: its material cuts them
    palette:[4]u8,         // a Volume: the layers of uv0 and uv1
}

// The textures a piece shows its maps through, generated by the assets.
Piece_Maps :: struct {control,normal,paint:base.Asset_Id}

@(private)
surface_maps_init :: proc(m:^Surface_Maps,allocator:=context.allocator) {
    m.control=make([dynamic]u32,allocator)
    m.normal=make([dynamic][4]u8,allocator)
    m.paint=make([dynamic][4]u8,allocator)
}

@(private)
surface_maps_destroy :: proc(m:^Surface_Maps) {
    delete(m.control);delete(m.normal);delete(m.paint)
    m^={}
}

@(private)
surface_maps_clear :: proc(m:^Surface_Maps) {
    clear(&m.control);clear(&m.normal);clear(&m.paint)
    m.size,m.spacing,m.holed,m.palette={},0,false,{}
}

@(private)
normal_bytes :: #force_inline proc "contextless" (n:[3]f32) -> [4]u8 {
    return {u8(clamp(n.x*127.5+127.5,0,255)),u8(clamp(n.y*127.5+127.5,0,255)),u8(clamp(n.z*127.5+127.5,0,255)),255}
}

// The maps of the piece over the samples low to high, inclusive, a texel each
// spacing of them. A chunk (coarse false) reads its samples; a node, the
// coarse grid, as its vertices do.
@(private)
surface_maps_build :: proc(s:^Source,low,high:[2]int,spacing:int,coarse:bool,cuts:[]Join_Cut,m:^Surface_Maps) -> bool {
    surface_maps_clear(m)
    size:=[2]int{(high.x-low.x+spacing-1)/spacing+1,(high.y-low.y+spacing-1)/spacing+1}
    count:=size.x*size.y
    painted:=!grid_none(&s.paint)
    if resize(&m.control,count)!=nil || resize(&m.normal,count)!=nil || painted && resize(&m.paint,count)!=nil {return false}
    m.size,m.spacing=size,spacing
    nx,nz:=int(s.samples.x),int(s.samples.z)
    layers:=int(s.layer_count)
    for j in 0..<size.y {for i in 0..<size.x {
        x,z:=min(low.x+i*spacing,high.x),min(low.y+j*spacing,high.y)
        at:=i+size.x*j
        mix:Layer_Mix
        normal:[3]f32
        if coarse {
            normal=coarse_normal(s,x,z,spacing)
            mix=layers_vertex(s,coarse_weights(s,x,z),coarse_normal(s,x,z,LAYER_RULE_SAMPLES),coarse_height(s,x,z))
            if painted {m.paint[at]=coarse_paint(s,x,z)}
        } else {
            normal=heightfield_normal(s,x,z,1)
            mix=layers_vertex(s,weights_float(grid_get(&s.weights,x,z)),heightfield_normal(s,x,z,LAYER_RULE_SAMPLES),grid_get(&s.field,x,z))
            if painted {m.paint[at]=grid_get(&s.paint,x,z)}
        }
        control:=u32(weights_quantize(mix,layers))
        // The hole of the cell from the texel: those of the samples, or what share of them is holes.
        if x<nx-1 && z<nz-1 {
            if coarse || spacing>1 {
                if piece_hole_share(s,cuts,{x,z},{min(x+spacing,nx-1),min(z+spacing,nz-1)},coarse)>=0.5 {control|=WEIGHT_HOLE}
            } else if cell_hole(s,cuts,x,z) {control|=WEIGHT_HOLE}
        }
        m.control[at]=control
        m.normal[at]=normal_bytes(normal)
    }}
    return true
}

// What share of the cells low to before high are holes: of a node, as the
// coarse grid holds them (the cuts of its joins exact).
@(private)
piece_hole_share :: proc "contextless" (s:^Source,cuts:[]Join_Cut,low,high:[2]int,coarse:bool) -> f32 {
    area:=f32(max(high.x-low.x,1)*max(high.y-low.y,1))
    cut:=f32(0)
    for c in cuts {
        a:=[2]int{max(low.x,c.low.x),max(low.y,c.low.y)}
        b:=[2]int{min(high.x,c.high.x),min(high.y,c.high.y)}
        if a.x<b.x && a.y<b.y {cut+=f32((b.x-a.x)*(b.y-a.y))}
    }
    holes:=coarse?coarse_hole_share(s,low,high):source_hole_share(s,low,high)
    return min(holes+cut/area,1)
}

// What share of the cells low to before high are holes, from the samples.
@(private)
source_hole_share :: proc "contextless" (s:^Source,low,high:[2]int) -> f32 {
    if grid_none(&s.holes) {return 0}
    holes:=0
    for z in low.y..<high.y {for x in low.x..<high.x {if source_hole(s,x,z) {holes+=1}}}
    return f32(holes)/f32(max((high.x-low.x)*(high.y-low.y),1))
}

// Whether a triangle of a piece over the cells low to before high, in samples,
// is left out: every cell under it is a hole. One over some holes stays,
// and its piece cuts them by its material (Surface_Maps.holed).
@(private)
piece_triangle_holes :: proc(s:^Source,p:Piece,mesh:^Chunk_Mesh,low,high:[2]int) -> (skip:bool) {
    m:=&mesh.maps
    holes,cells:=0,0
    if m.spacing<=1 {
        for z in low.y..<high.y {for x in low.x..<high.x {
            cells+=1
            if cell_hole(s,p.cuts,x,z) {holes+=1}
        }}
    } else {
        // Of a node: the holes its map cuts.
        for j:=(low.y-p.low.y)/m.spacing;j*m.spacing+p.low.y<high.y;j+=1 {for i:=(low.x-p.low.x)/m.spacing;i*m.spacing+p.low.x<high.x;i+=1 {
            if i>=m.size.x || j>=m.size.y {continue}
            cells+=1
            if m.control[i+m.size.x*j]&WEIGHT_HOLE!=0 {holes+=1}
        }}
    }
    if holes>0 && holes<cells {m.holed=true}
    return cells>0 && holes==cells
}

// The layers of a piece of a Volume: the four that weigh most over its
// vertices, each vertex with their shares in its uv0 and uv1.
@(private)
volume_palette :: proc(s:^Source,mesh:^Chunk_Mesh) -> bool {
    m:=&mesh.geometry
    if resize(&m.uvs,len(m.positions))!=nil || resize(&mesh.uv1s,len(m.positions))!=nil {return false}
    mixes:=make([]Layer_Mix,len(m.positions),context.temp_allocator)
    total:Layer_Mix
    for position,i in m.positions {
        mixes[i]=layers_vertex(s,source_weights_at(s,position),i<len(m.normals)?m.normals[i]:{0,1,0},position.y)
        total+=mixes[i]
    }
    palette:[4]int
    for slot in 0..<4 {
        best:=0
        for layer in 1..<int(s.layer_count) {if total[layer]>total[best] {best=layer}}
        palette[slot]=best
        total[best]=-1
    }
    for slot in 0..<4 {mesh.maps.palette[slot]=u8(palette[slot])}
    for &mix,i in mixes {
        w:[4]f32
        sum:=f32(0)
        for slot in 0..<4 {
            if slot>=int(s.layer_count) {break}
            w[slot]=max(mix[palette[slot]],0)
            sum+=w[slot]
        }
        w=sum>0?w/sum:{1,0,0,0}
        m.uvs[i],mesh.uv1s[i]={w[0],w[1]},{w[2],w[3]}
    }
    return true
}

// Gives the assets the textures of the maps of a piece. False without room or
// memory for them, with none made.
piece_maps_publish :: proc(a:^host.Assets,m:^Surface_Maps) -> (maps:Piece_Maps,ok:bool) {
    if m.size=={} {return {},true}
    w,h:=m.size.x,m.size.y
    maps.control,ok=host.assets_texture_generate(a,mem.slice_to_bytes(m.control[:]),w,h,false,"terrain control")
    if !ok {return {},false}
    maps.normal,ok=host.assets_texture_generate(a,mem.slice_to_bytes(m.normal[:]),w,h,false,"terrain normal")
    if ok && len(m.paint)>0 {maps.paint,ok=host.assets_texture_generate(a,mem.slice_to_bytes(m.paint[:]),w,h,true,"terrain paint")}
    if !ok {piece_maps_release(a,&maps);return {},false}
    return maps,true
}

piece_maps_release :: proc(a:^host.Assets,maps:^Piece_Maps) {
    for id in ([3]base.Asset_Id{maps.control,maps.normal,maps.paint}) {if id!={} {host.assets_texture_release(a,id)}}
    maps^={}
}

// What a piece gives the program of its material over those of its layers:
// its maps and their size, or the palette of a piece of a Volume.
piece_values :: proc(o:^render.Material_Values,maps:Piece_Maps,m:Piece_Shape) {
    render.material_texture(o,base.name_hash("control"),0,maps.control)
    render.material_texture(o,base.name_hash("normal"),0,maps.normal)
    render.material_texture(o,base.name_hash("paint"),0,maps.paint)
    render.material_value(o,"piece",{f32(m.size.x),f32(m.size.y),m.size=={}?1:0,m.texel})
    render.material_value(o,"palette",{f32(m.palette[0]),f32(m.palette[1]),f32(m.palette[2]),f32(m.palette[3])})
}

// What the values of a piece read of its maps, kept with the piece: their
// size, the metres of a texel, the palette of a piece of a Volume and
// whether its material cuts holes.
Piece_Shape :: struct {size:[2]int,texel:f32,palette:[4]u8,holed:bool}

piece_shape :: proc "contextless" (s:^Source,m:^Surface_Maps) -> Piece_Shape {return {m.size,s.cell*f32(max(m.spacing,1)),m.palette,m.holed}}
