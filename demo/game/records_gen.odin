package game

// Generated by mirai build from the .records of the assets that declare their type: edit those, not this.

import "mirai:core"
import "mirai:std/base"

@(record="ai/horde_waves.records",description="A wave of a horde: delay seconds after the wave before it, count zombies interval seconds apart, each at the next spawn point of the game; then the wave next. A wave that names one before it repeats them.")
Horde_Wave :: struct {
    delay:f32 `mirai:"min=0,unit=s"`,
    interval:f32 `mirai:"min=0,unit=s"`,
    count:i32 `mirai:"min=0,max=500"`,
    next:core.Record(Horde_Wave),
}

Item_Rarity :: enum u8 {Common,Rare,Epic}

@(record="interface/items.records",description="An item a slot of the inventory holds: its name, its icon, how rare it is and how many of it a slot holds.")
Item :: struct {
    title:core.Text,
    icon:base.Asset_Id `mirai:"kind=.tex"`,
    rarity:Item_Rarity,
    stack:i32 `mirai:"min=1"`, // units a slot holds at most
}
ITEM_DEFAULT :: Item{stack=1}

@(record="interface/merchant_answers.records",description="An answer to a line: offered while the flag requires is set and refuses is not, it sets the flag sets and goes to the line to; without to, the conversation ends.")
Dialogue_Choice :: struct {
    line:core.Record(Dialogue_Line),
    text:core.Text,
    to:core.Record(Dialogue_Line),
    requires:[16]u8 `mirai:"text"`, // a flag by name; empty: none
    refuses:[16]u8 `mirai:"text"`, // a flag by name; empty: none
    sets:[16]u8 `mirai:"text"`, // a flag by name; empty: none
}

@(record="interface/merchant_lines.records",description="A line of a conversation: who says it and what. The player answers with the Dialogue_Choice rows that name it; without them it goes on to next, and without next the conversation ends.")
Dialogue_Line :: struct {
    speaker:core.Text,
    text:core.Text,
    next:core.Record(Dialogue_Line),
}
