// The World_Info of a @(test_world) of this package, which says of its tables
// and storages what that of a game says: test_info_destroy frees it.
test_info :: proc(t:^testing.T,$W:typeid,allocator:=context.allocator,loc:=#caller_location) -> (info:World_Info,ok:bool) {
    when W==Made_World {info,ok=test_info_made_world(allocator)}
    else when W==Paced_World {info,ok=test_info_paced_world(allocator)}
    else when W==World_Of_Single {info,ok=test_info_world_of_single(allocator)}
    else when W==World_Of_Probes {info,ok=test_info_world_of_probes(allocator)}
    else when W==World_Of_Locks {info,ok=test_info_world_of_locks(allocator)}
    else when W==Tree_World {info,ok=test_info_tree_world(allocator)}
    else when W==Id_World {info,ok=test_info_id_world(allocator)}
    else when W==Memory_From {info,ok=test_info_memory_from(allocator)}
    else when W==Memory_To {info,ok=test_info_memory_to(allocator)}
    else when W==Before_World {info,ok=test_info_before_world(allocator)}
    else when W==After_World {info,ok=test_info_after_world(allocator)}
    else when W==Aim_World {info,ok=test_info_aim_world(allocator)}
    else when W==Later_World {info,ok=test_info_later_world(allocator)}
    else when W==Hierarchy_Fixture {info,ok=test_info_hierarchy_fixture(allocator)}
    else when W==Rev_World {info,ok=test_info_rev_world(allocator)}
    else when W==Roll_World {info,ok=test_info_roll_world(allocator)}
    else when W==Run_World {info,ok=test_info_run_world(allocator)}
    else when W==Run_Kept_World {info,ok=test_info_run_kept_world(allocator)}
    else when W==Indexed_World {info,ok=test_info_indexed_world(allocator)}
    else when W==Union_World {info,ok=test_info_union_world(allocator)}
    else {#panic("test_info: W is not a @(test_world) of the tests of core; mark its struct, at the top of a test file of this package, with @(test_world)")}
    testing.expect(t,ok,"no memory for the World_Info of a test world",loc=loc)
    return
}
